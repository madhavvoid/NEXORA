<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nexora">

        <!-- Splash Screen -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Login Screen -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false" />

        <!-- Main Activity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- Register Screen -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false" />


        <!-- student Dashboard -->
        <activity
            android:name=".activities.StudentDashboardActivity"
            android:exported="false" />


        <!-- Approval Screen -->
        <activity
            android:name=".activities.StudentApprovalActivity"
            android:exported="false" />

        <!-- Subject Screen -->
        <activity
            android:name=".activities.SubjectManagementActivity"
            android:exported="false" />

        <!-- Attendance Screen -->
        <activity
            android:name=".activities.AttendanceManagementActivity"
            android:exported="false" />

        <!-- Mark Screen -->
        <activity
            android:name=".activities.MarksManagementActivity"
            android:exported="false" />

        <!-- MyAttendance Screen -->
        <activity
            android:name=".activities.MyAttendanceActivity"
            android:exported="false" />

        <!-- MyResult Screen -->

        <activity
            android:name=".activities.MyResultsActivity"
            android:exported="false" />



        <!-- MyAnnouncement-->
        <activity
            android:name=".activities.ManageAnnouncementsActivity"
            android:exported="false" />


        <!-- Student Announcement-->
        <activity
            android:name=".activities.StudentAnnouncementsActivity"
            android:exported="false" />



        <!-- StudentSubject-->
        <activity
            android:name=".activities.StudentSubjectsActivity"
            android:exported="false" />

    </application>

</manifest>