<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexora_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/nexora_navy"
            android:padding="22dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXORA  /  ADMIN"
                android:textColor="#93C5FD"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Student Approvals"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Review and manage new student registrations."
                android:textColor="#D1D9E8"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Back button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back to Dashboard"
            android:textAllCaps="false"
            android:textColor="@color/nexora_navy"
            app:backgroundTint="@color/white"
            app:cornerRadius="10dp"
            app:strokeColor="@color/nexora_border"
            app:strokeWidth="1dp"
            android:layout_marginBottom="20dp" />

        <!-- Section title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pending Registrations"
            android:textColor="@color/nexora_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Approve students to give them access to NEXORA."
            android:textColor="@color/nexora_text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="18dp" />

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/progressApprovals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="@color/nexora_blue"
            android:visibility="gone"
            android:layout_margin="20dp" />

        <!-- Status / empty message -->
        <TextView
            android:id="@+id/tvApprovalStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading registrations..."
            android:textColor="@color/nexora_text_secondary"
            android:textSize="15sp"
            android:gravity="center"
            android:padding="20dp"
            android:visibility="gone" />

        <!-- Student cards will be added here by Java -->
        <LinearLayout
            android:id="@+id/approvalContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
