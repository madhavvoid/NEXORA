<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexora_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStudentSubjectsBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Back to Dashboard"
            android:textAllCaps="false"
            android:textColor="@color/nexora_navy"
            app:backgroundTint="@color/white"
            app:cornerRadius="10dp"
            app:icon="@android:drawable/ic_media_previous"
            app:strokeColor="@color/nexora_border"
            app:strokeWidth="1dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="My Subjects"
            android:textColor="@color/nexora_navy"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStudentSubjectsCourse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Your academic subjects"
            android:textColor="@color/nexora_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/nexora_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvStudentSubjectsCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 subjects available"
                    android:textColor="@color/nexora_navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progressStudentSubjects"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="12dp"
                    android:indeterminateTint="@color/nexora_blue"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvStudentSubjectsMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="Loading subjects..."
                    android:textColor="@color/nexora_text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/studentSubjectsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Subjects provided by your administrator"
            android:textColor="@color/nexora_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
